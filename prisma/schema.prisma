generator db {
  provider             = "prisma-client-py"
  interface            = "asyncio"
  recursive_type_depth = "5"
  enable_experimental_decimal = true
}

datasource db {
  provider = "postgresql"
  url      = "postgresql://postgres:root@localhost:5432/prokat?schema=public"
}

model clients {
  id                   Int                 @id @default(autoincrement())
  full_name            String              @db.VarChar(256)
  passport_series      String              @db.VarChar(4)
  passport_number      String              @db.VarChar(6)
  passport_issued_by   String
  passport_date_issued DateTime            @db.Date
  actual_address       String
  mobile_phone         String              @db.VarChar(20)
  home_phone           String?             @db.VarChar(20)
  registration_date    DateTime?           @default(now()) @db.Timestamp(6)
  reliability_status   String?             @db.VarChar(20)
  discount_pct         Decimal?            @db.Decimal(5, 2)
  birth_date           DateTime            @db.Date
  rental_agreements    rental_agreements[]
}

model media_items {
  id                Int                 @id @default(autoincrement())
  movie_id          Int?
  item_type         String?             @db.VarChar(20)
  current_condition String?             @db.VarChar(30)
  rack_number       Int
  shelf_number      Int
  purchase_cost     Decimal?            @db.Decimal(10, 2)
  status            String?             @db.VarChar(20)
  movies            movies?             @relation(fields: [movie_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  rental_agreements rental_agreements[]
}

model movies {
  id              Int           @id @default(autoincrement())
  title_ru        String        @db.VarChar(256)
  title_orig      String?       @db.VarChar(256)
  director        String        @db.VarChar(256)
  main_actors     String?
  release_year    Int?
  country         String?       @db.VarChar(100)
  genre           String        @db.VarChar(100)
  age_rating      String        @db.VarChar(3)
  duration_min    Int?
  annotation      String?
  base_daily_rate Decimal?      @db.Decimal(10, 2)
  media_items     media_items[]
}

model rental_agreements {
  id                  Int          @id @default(autoincrement())
  client_id           Int?
  media_id            Int?
  issue_date_time     DateTime?    @default(now()) @db.Timestamp(6)
  planned_return_date DateTime     @db.Date
  actual_return_date  DateTime?    @db.Date
  deposit_amount      Decimal?     @db.Decimal(10, 2)
  prepayment_amount   Decimal?     @db.Decimal(10, 2)
  penalty_amount      Decimal?     @db.Decimal(10, 2)
  clients             clients?     @relation(fields: [client_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  media_items         media_items? @relation(fields: [media_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}
